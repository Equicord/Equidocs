---
interface Member {
  avatar: string;
  name: string;
  title: string;
  github?: string;
  website?: string;
}

interface Props {
  members: Member[];
}

const { members } = Astro.props;
---

<div class="team-grid">
  {members.map((member) => (
    <div class="team-card">
      <div class="team-avatar-wrapper">
        <img src={member.avatar} alt={member.name} class="team-avatar" width="72" height="72" />
      </div>

      <p class="team-name">{member.name}</p>
      <p class="team-title">{member.title}</p>

      <div class="team-links">
        {member.github && (
          <a href={member.github} target="_blank" rel="noopener" aria-label="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.1-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.73 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.74.8 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.42.36.78 1.08.78 2.18 0 1.57-.01 2.84-.01 3.23 0 .3.2.66.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/>
            </svg>
          </a>
        )}
        {member.website && (
          <a href={member.website} target="_blank" rel="noopener" aria-label="Website">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
              <path d="M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            </svg>
          </a>
        )}
      </div>
    </div>
  ))}
</div>

<style>
.team-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 1.5rem;
  margin-top: 1.5rem;
  align-items: start;
}

.team-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.team-avatar-wrapper {
  width: 72px;
  height: 72px;
  margin-bottom: 0.5rem;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
}

.team-avatar {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.team-name {
  font-weight: 600;
  margin: 0;
  min-height: 2.6em;
  display: flex;
  align-items: center;
  justify-content: center;
}

.team-title {
  font-size: 0.85rem;
  color: var(--sl-color-gray-3);
  margin: 0 0 0.25rem;
}

.team-links {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0.6rem;
}

.team-links a {
  display: flex;
  color: var(--sl-color-gray-3);
  transition: color 0.15s;
}

.team-links a:hover {
  color: var(--sl-color-white);
}
</style>